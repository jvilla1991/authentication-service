# authentication-service — production environment variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env (which is gitignored) and fill in real values.
# Used by docker-compose and any process runner that loads .env files.

# Activate the production Spring profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL connection
# Format: jdbc:postgresql://<host>:<port>/<database>
DATABASE_URL=jdbc:postgresql://localhost:5432/table_mimic
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password

# JWT signing key — must be at least 256 bits, Base64-encoded.
# Generate a new one with:  openssl rand -base64 32
DECODER_KEY=<replace-with-your-generated-key>

# Docker Compose database bootstrap (only needed if running the db service)
POSTGRES_DB=table_mimic
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
